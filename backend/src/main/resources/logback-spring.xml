<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 1. Define base folder for your logs -->
    <property name="LOG_DIR" value="logs" />
    <property name="LOG_PREFIX" value="ena-mam" />

    <!-- 2. Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 3. Daily Rolling File Appender with Year/Month Folder Structure -->
    <appender name="DAILY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- We omit the <file> tag here so Logback writes directly to the patterned file path -->

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!--
               The %d{yyyy/MM/dd} pattern forces a daily roll.
               Logback automatically interprets the slashes as directories.
               Output example: logs/2026/10/15.log
            -->
            <fileNamePattern>${LOG_DIR}/%d{yyyy/MM/dd}.log</fileNamePattern>

            <!-- Keep exactly 365 days of logs before deleting old ones -->
            <maxHistory>365</maxHistory>

            <!-- Total size cap for all logs -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %-5level | %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 4. Apply the appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="DAILY_FILE" />
    </root>
</configuration>